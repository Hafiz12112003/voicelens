DATABASE_URL=sqlite:///voicelens.db
CORS_ORIGINS=http://localhost:5173
LATENCY_THRESHOLD_MS=1500
LATENCY_HIGH_MS=3000
# Public demo: when on (1, true, yes or on), importing calls and reviewing findings return 403.
# Reads and POST /analyze keep working. Off by default.
READ_ONLY=0

# Frontend (Vite). Use the full Flask URL when deployed, e.g. https://your-api.example.com/api/v1
VITE_API_BASE=/api/v1
# "snapshot" forces the bundled read-only snapshot; anything else uses the live API
VITE_API_MODE=live
